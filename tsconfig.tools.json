{
  // The tools, the check.mjs template and the tests, checked with their JSDoc types. lib ES2022 keeps
  // the template and the tools to what Node 18 has (vendor/check.mjs runs on Node 18 in the editions).
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "noUnusedLocals": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["tools/**/*.mjs", "vendor/**/*.mjs", "test/**/*.ts", "test/**/*.mjs", "vitest.config.ts"]
}
